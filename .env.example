# Copy to .env and fill in. Only EXPO_PUBLIC_* vars are exposed to the app bundle.
# These are not "secrets" in the backend sense — an MMP dev key / app token ships
# inside every mobile app by design.

# --- AppsFlyer ---
EXPO_PUBLIC_AF_ENABLED=true
EXPO_PUBLIC_AF_DEV_KEY=your_appsflyer_dev_key
# iOS App Store numeric id (required on iOS; from App Store Connect / TestFlight record)
EXPO_PUBLIC_AF_APP_ID=1234567890
EXPO_PUBLIC_AF_DEBUG=true

# --- Adjust ---
EXPO_PUBLIC_ADJUST_ENABLED=false
EXPO_PUBLIC_ADJUST_APP_TOKEN=your_adjust_app_token
EXPO_PUBLIC_ADJUST_ENV=sandbox
# Map canonical events to Adjust event tokens (created in the Adjust dashboard).
# JSON object; keys are canonical event names.
EXPO_PUBLIC_ADJUST_EVENT_TOKENS={"purchase":"abc123","add_to_cart":"def456","begin_checkout":"ghi789","view_item":"jkl012"}
